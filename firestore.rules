rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role in ['admin', 'owner', 'moderator']
      );
    }

    // Profiles - public read, only owner can write
    match /profiles/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
      allow create: if isAuthenticated();
    }
    
    // Services - public read, only owner can write
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated();
    }
    
    // Projects - public read, only owner can write
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated();
    }
    
    // Orders - only participants can read/write
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        request.resource.data.buyerId == request.auth.uid ||
        request.resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAuthenticated() && (
        request.resource.data.buyerId == request.auth.uid ||
        request.resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated();
    }
    
    // Wallets - only owner can read/write
    match /wallets/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    // Withdrawals - only owner can create, admin can read
    match /withdrawals/{withdrawalId} {
      allow read: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated();
    }
    
    // Transactions - only owner can read/create
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow write: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
    }
    
    // Notifications - only owner can read
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow write: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
    }
    
    // Tickets - only owner can read/write
    match /tickets/{ticketId} {
      allow read, write: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated();
    }
    
    // Disputes - participants and admin only
    match /disputes/{disputeId} {
      allow read, write: if isAuthenticated() && (
        request.resource.data.buyerId == request.auth.uid ||
        request.resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated();
    }
    
    // Escrow transactions - participants and admin only
    match /escrow_transactions/{escrowId} {
      allow read, write: if isAuthenticated() && (
        request.resource.data.buyerId == request.auth.uid ||
        request.resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated();
    }
    
    // Following/Followers
    match /following/{docId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == docId;
      allow create: if isAuthenticated();
    }
    
    match /followers/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
      allow create: if isAuthenticated();
    }
    
    // Reviews - public read, authenticated write
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isAuthenticated();
      allow create: if isAuthenticated();
    }
    
    // Categories - public read only
    match /categories/{categoryId} {
      allow read: if true;
    }
    
    // Admin collections - admin only
    match /admin/{docId=**} {
      allow read, write: if isAdmin();
    }
    
    // Security logs - admin only
    match /security_logs/{logId} {
      allow read, write: if isAdmin();
    }
    
    // Security alerts - admin only
    match /securityAlerts/{docId} {
      allow read, write: if isAdmin();
    }
    
    // Default - deny all
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
